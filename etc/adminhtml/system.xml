<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="softaware_datafeed" translate="label" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Data Feed Manager</label>
            <tab>softaware</tab>
            <resource>Softaware_DataFeed::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1">
                <attribute type="expanded">1</attribute>
                <label>General</label>
                <comment><![CDATA[Feeds are created in Softaware &gt; Data Feed Manager &gt; Feeds; store view, currency and schedule are set per feed. The settings here apply to all feeds.]]></comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When set to No, no feeds are generated (cron, admin or command line). Existing feed files stay in place. Default: Yes.</comment>
                </field>
            </group>
            <group id="generation" translate="label" sortOrder="20" showInDefault="1">
                <label>Generation</label>
                <field id="batch_size" translate="label comment" type="text" sortOrder="20" showInDefault="1" canRestore="1">
                    <label>Batch Size</label>
                    <config_path>softaware_datafeed/general/batch_size</config_path>
                    <validate>required-entry validate-digits validate-digits-range digits-range-10-5000</validate>
                    <comment>Products loaded at a time, 10–5000. Default: 250. Lower it if generation runs out of memory (variants of configurable products come on top).</comment>
                </field>
                <field id="preview_limit" translate="label comment" type="text" sortOrder="30" showInDefault="1" canRestore="1">
                    <label>Preview Items</label>
                    <config_path>softaware_datafeed/general/preview_limit</config_path>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-20</validate>
                    <comment>Items rendered by the feed preview, 1 to 20. Default: 5.</comment>
                </field>
                <field id="log_retention_days" translate="label comment" type="text" sortOrder="40" showInDefault="1" canRestore="1">
                    <label>Keep Generation Log For (Days)</label>
                    <config_path>softaware_datafeed/general/log_retention_days</config_path>
                    <validate>required-entry validate-digits</validate>
                    <comment>Older log entries are deleted daily. Default: 30; 0 keeps the log for ever.</comment>
                </field>
            </group>
            <group id="product_data" translate="label" sortOrder="30" showInDefault="1">
                <label>Product Data</label>
                <field id="brand_attribute" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Brand Attribute</label>
                    <source_model>Softaware\DataFeed\Model\Source\BrandAttribute</source_model>
                    <comment>Used by the template variable product.brand (g:brand in the Google Shopping template, brand in the Meta, Pinterest and Microsoft templates). A variant without a value uses its parent's value; the templates use the store name only when there is no brand at all. Default: Automatic (the attribute "brand" if your store has one, otherwise "manufacturer").</comment>
                </field>
            </group>
        </section>
    </system>
</config>
