<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="softaware_datafeed_feed" resource="default" engine="innodb" comment="Softaware Data Feed: feeds">
        <column xsi:type="int" name="feed_id" unsigned="true" nullable="false" identity="true" comment="Feed ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Enabled"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="1" comment="Store view"/>
        <column xsi:type="varchar" name="format" nullable="false" length="10" default="xml" comment="xml, json, csv or txt"/>
        <column xsi:type="varchar" name="filename" nullable="false" length="255" comment="File name"/>
        <column xsi:type="varchar" name="path" nullable="false" length="255" default="pub/media/feeds/" comment="Directory relative to the Magento root"/>
        <column xsi:type="varchar" name="currency_code" nullable="true" length="3" comment="Feed currency"/>
        <column xsi:type="mediumtext" name="template" nullable="true" comment="XML/JSON template"/>
        <column xsi:type="mediumtext" name="columns" nullable="true" comment="CSV/TXT column map (JSON)"/>
        <column xsi:type="varchar" name="csv_delimiter" nullable="false" length="10" default="," comment="Delimiter"/>
        <column xsi:type="varchar" name="csv_enclosure" nullable="true" length="10" comment="Enclosure (empty = double quote)"/>
        <column xsi:type="varchar" name="csv_encoding" nullable="false" length="20" default="UTF-8" comment="Encoding"/>
        <column xsi:type="smallint" name="csv_include_header" unsigned="true" nullable="false" default="1" comment="Include header row"/>
        <column xsi:type="varchar" name="csv_line_ending" nullable="false" length="4" default="lf" comment="lf or crlf"/>
        <column xsi:type="varchar" name="filter_types" nullable="true" length="255" comment="Product types"/>
        <column xsi:type="text" name="filter_attribute_sets" nullable="true" comment="Attribute set IDs"/>
        <column xsi:type="varchar" name="filter_visibility" nullable="true" length="32" comment="Visibility values"/>
        <column xsi:type="smallint" name="filter_enabled_only" unsigned="true" nullable="false" default="1" comment="Enabled products only"/>
        <column xsi:type="smallint" name="filter_in_stock_only" unsigned="true" nullable="false" default="0" comment="In-stock products only"/>
        <column xsi:type="text" name="filter_categories" nullable="true" comment="Category IDs"/>
        <column xsi:type="varchar" name="filter_category_mode" nullable="false" length="10" default="include" comment="include or exclude"/>
        <column xsi:type="mediumtext" name="filter_conditions" nullable="true" comment="Attribute conditions (JSON)"/>
        <column xsi:type="text" name="exclude_skus" nullable="true" comment="SKUs to leave out"/>
        <column xsi:type="varchar" name="parent_child_mode" nullable="false" length="10" default="parent" comment="parent, child or both"/>
        <column xsi:type="varchar" name="schedule_type" nullable="false" length="10" default="manual" comment="manual, times or cron"/>
        <column xsi:type="varchar" name="schedule_times" nullable="true" length="255" comment="Daily times HH:MM, comma separated"/>
        <column xsi:type="varchar" name="schedule_cron" nullable="true" length="100" comment="Cron expression"/>
        <column xsi:type="datetime" name="next_run_at" nullable="true" comment="Next scheduled run (UTC)"/>
        <column xsi:type="smallint" name="ftp_enabled" unsigned="true" nullable="false" default="0" comment="Upload enabled"/>
        <column xsi:type="varchar" name="ftp_protocol" nullable="false" length="10" default="sftp" comment="ftp, ftps or sftp"/>
        <column xsi:type="varchar" name="ftp_host" nullable="true" length="255" comment="Host"/>
        <column xsi:type="int" name="ftp_port" unsigned="true" nullable="true" comment="Port"/>
        <column xsi:type="varchar" name="ftp_username" nullable="true" length="255" comment="Username"/>
        <column xsi:type="text" name="ftp_password" nullable="true" comment="Password (encrypted)"/>
        <column xsi:type="varchar" name="ftp_path" nullable="true" length="255" comment="Remote directory"/>
        <column xsi:type="smallint" name="ftp_passive" unsigned="true" nullable="false" default="1" comment="Passive mode"/>
        <column xsi:type="datetime" name="generated_at" nullable="true" comment="Last generation (UTC)"/>
        <column xsi:type="int" name="generated_items" unsigned="true" nullable="true" comment="Items in last generation"/>
        <column xsi:type="bigint" name="generated_size" unsigned="true" nullable="true" comment="File size in bytes"/>
        <column xsi:type="varchar" name="generated_status" nullable="true" length="20" comment="success, warning or error"/>
        <column xsi:type="text" name="generated_message" nullable="true" comment="Last generation message"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="feed_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_DATAFEED_FEED_STORE_ID_STORE_STORE_ID"
                    table="softaware_datafeed_feed" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="SOFTAWARE_DATAFEED_FEED_IS_ACTIVE_NEXT_RUN_AT" indexType="btree">
            <column name="is_active"/>
            <column name="next_run_at"/>
        </index>
    </table>
    <table name="softaware_datafeed_log" resource="default" engine="innodb" comment="Softaware Data Feed: generation log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="feed_id" unsigned="true" nullable="false" comment="Feed ID"/>
        <column xsi:type="varchar" name="trigger_source" nullable="false" length="10" default="admin" comment="admin, cron or cli"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="running" comment="running, success, warning or error"/>
        <column xsi:type="datetime" name="started_at" nullable="false" comment="Started (UTC)"/>
        <column xsi:type="datetime" name="finished_at" nullable="true" comment="Finished (UTC)"/>
        <column xsi:type="decimal" name="duration" scale="2" precision="10" unsigned="true" nullable="true" comment="Seconds"/>
        <column xsi:type="int" name="items" unsigned="true" nullable="false" default="0" comment="Items written"/>
        <column xsi:type="int" name="error_count" unsigned="true" nullable="false" default="0" comment="Errors"/>
        <column xsi:type="bigint" name="file_size" unsigned="true" nullable="true" comment="File size in bytes"/>
        <column xsi:type="mediumtext" name="messages" nullable="true" comment="Messages"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_DATAFEED_LOG_FEED_ID_SOFTAWARE_DATAFEED_FEED_FEED_ID"
                    table="softaware_datafeed_log" column="feed_id" referenceTable="softaware_datafeed_feed" referenceColumn="feed_id" onDelete="CASCADE"/>
        <index referenceId="SOFTAWARE_DATAFEED_LOG_FEED_ID_STARTED_AT" indexType="btree">
            <column name="feed_id"/>
            <column name="started_at"/>
        </index>
    </table>
    <table name="softaware_datafeed_taxonomy" resource="default" engine="innodb" comment="Softaware Data Feed: Google product taxonomy">
        <column xsi:type="int" name="taxonomy_id" unsigned="true" nullable="false" identity="false" comment="Google category ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Category name"/>
        <column xsi:type="varchar" name="path" nullable="false" length="1024" comment="Full path"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="taxonomy_id"/>
        </constraint>
    </table>
    <table name="softaware_datafeed_category_map" resource="default" engine="innodb" comment="Softaware Data Feed: store category to Google category">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="false" comment="Catalog category ID"/>
        <column xsi:type="int" name="taxonomy_id" unsigned="true" nullable="false" comment="Google category ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_id"/>
        </constraint>
    </table>
</schema>
