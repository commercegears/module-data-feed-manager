/** @var \CommerceGears\DataFeed\Block\Adminhtml\Feed\Generate $block */
/** @var \Magento\Framework\Escaper $escaper */
$feed = $block->getFeed();
if (!$feed) {
    return;
}
$config = [
    'stepUrl' => $block->getStepUrl(),
    'feedId' => (int)$feed->getId(),
    'locked' => $block->isLocked(),
    'labels' => [
        'starting' => __('Preparing…'),
        'progress' => __('%1 of %2 products processed, %3 items written'),
        'finishing' => __('Writing and checking the file…'),
        'success' => __('Feed generated'),
        'warning' => __('Feed generated with warnings'),
        'error' => __('Feed not generated'),
        'items' => __('Items'),
        'errors' => __('Errors'),
        'size' => __('File size'),
        'duration' => __('Duration'),
        'seconds' => __('%1 s'),
        'open' => __('Open feed'),
        'messages' => __('Messages'),
        'locked' => __('This feed is already being generated (by cron, the CLI or another browser tab).'),
        'force' => __('Start anyway'),
        'network' => __('The request failed (%1). The generation stopped; start it again.'),
    ],
];
?>
<div class="commercegears-datafeed-generate" id="commercegears-datafeed-generate"
     data-mage-init='<?= $escaper->escapeHtmlAttr(json_encode(['CommerceGears_DataFeed/js/generate' => $config])) ?>'>
    <table class="commercegears-datafeed-facts">
        <tr>
            <th><?= $escaper->escapeHtml(__('Feed')) ?></th>
            <td><?= $escaper->escapeHtml($feed->getName()) ?> (<?= $escaper->escapeHtml(strtoupper($feed->getFormat())) ?>)</td>
        </tr>
        <tr>
            <th><?= $escaper->escapeHtml(__('File')) ?></th>
            <td><code><?= $escaper->escapeHtml($block->getFilePath()) ?></code></td>
        </tr>
    </table>
    <div class="commercegears-datafeed-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="commercegears-datafeed-progress-bar" data-role="bar"></div>
    </div>
    <p class="commercegears-datafeed-progress-text" data-role="text" aria-live="polite"><?= $escaper->escapeHtml(__('Preparing…')) ?></p>
    <div data-role="result"></div>
    <div class="commercegears-datafeed-actions">
        <a class="action-default" href="<?= $escaper->escapeUrl($block->getEditUrl()) ?>"><?= $escaper->escapeHtml(__('Back to Feed')) ?></a>
        <a class="action-default" href="<?= $escaper->escapeUrl($block->getLogUrl()) ?>"><?= $escaper->escapeHtml(__('Generation Log')) ?></a>
        <button type="button" class="action-secondary" data-role="restart" hidden><?= $escaper->escapeHtml(__('Generate Again')) ?></button>
    </div>
    <noscript><p><?= $escaper->escapeHtml(__('JavaScript is required. Alternatively run: bin/magento commercegears:feed:generate %1', (int)$feed->getId())) ?></p></noscript>
</div>
