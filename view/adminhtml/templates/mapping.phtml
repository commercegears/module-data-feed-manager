/** @var \Softaware\DataFeed\Block\Adminhtml\Mapping\Tree $block */
/** @var \Magento\Framework\Escaper $escaper */
$taxonomyCount = $block->getTaxonomyCount();
$rows = $block->getRows();
?>
<div class="softaware-datafeed-mapping"
     data-mage-init='<?= $escaper->escapeHtmlAttr(json_encode(['Softaware_DataFeed/js/mapping' => [
         'searchUrl' => $block->getSearchUrl(),
     ]])) ?>'>
    <div class="softaware-datafeed-intro">
        <p><?= $escaper->escapeHtml(__('Map your store categories to Google\'s product taxonomy. A product uses the mapping of its deepest category; categories without a mapping inherit the nearest mapped parent (shown in grey). The mapping applies to all feeds and store views.')) ?></p>
        <p class="softaware-datafeed-muted">
            <?= $escaper->escapeHtml(__('%1 Google categories loaded, %2 store categories mapped.', number_format($taxonomyCount), number_format($block->getMappedCount()))) ?>
            <?= $escaper->escapeHtml(__('In feed templates:')) ?>
            <code>{{ product.google_category_id }}</code>, <code>{{ product.google_category }}</code>
        </p>
    </div>

    <?php if ($taxonomyCount === 0): ?>
        <div class="message message-warning"><div><?= $escaper->escapeHtml(__('The Google taxonomy is not loaded yet. Import it below first.')) ?></div></div>
    <?php else: ?>
    <form action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>" method="post" class="softaware-datafeed-mapping-form"
          id="softaware-datafeed-mapping-form">
        <?= $block->getBlockHtml('formkey') ?>
        <div class="softaware-datafeed-filter">
            <label for="softaware-datafeed-mapping-filter"><?= $escaper->escapeHtml(__('Find category')) ?></label>
            <input type="search" id="softaware-datafeed-mapping-filter" class="admin__control-text" data-role="filter"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Type to filter the list')) ?>"/>
        </div>
        <table class="data-grid softaware-datafeed-mapping-table">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Store Category')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Google Product Category')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($rows as $row): ?>
                <tr data-role="row" data-name="<?= $escaper->escapeHtmlAttr(mb_strtolower($row['name'])) ?>">
                    <td class="level-<?= min(8, max(1, (int)$row['level'])) ?>">
                        <span class="softaware-datafeed-category<?= $row['active'] ? '' : ' softaware-datafeed-muted' ?>">
                            <?= $escaper->escapeHtml($row['name']) ?>
                        </span>
                        <small class="softaware-datafeed-muted">#<?= (int)$row['id'] ?><?= $row['active'] ? '' : ', ' . $escaper->escapeHtml(__('disabled')) ?></small>
                    </td>
                    <td>
                        <input type="text" class="admin__control-text" data-role="taxonomy"
                               name="mapping[<?= (int)$row['id'] ?>]"
                               value="<?= $escaper->escapeHtmlAttr($row['value']) ?>"
                               aria-label="<?= $escaper->escapeHtmlAttr(__('Google category for %1', $row['name'])) ?>"
                               placeholder="<?= $escaper->escapeHtmlAttr($row['inherited'] !== '' ? __('Inherited: %1', $row['inherited']) : __('Search, e.g. hoodies')) ?>"/>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
        <div class="softaware-datafeed-actions">
            <button type="submit" class="action-primary"><?= $escaper->escapeHtml(__('Save Mapping')) ?></button>
        </div>
    </form>
    <?php endif; ?>

    <form action="<?= $escaper->escapeUrl($block->getImportUrl()) ?>" method="post" enctype="multipart/form-data"
          class="softaware-datafeed-import">
        <?= $block->getBlockHtml('formkey') ?>
        <h3><?= $escaper->escapeHtml(__('Taxonomy Language')) ?></h3>
        <p><?= $escaper->escapeHtml(__('The English (en-GB) list is included. For another language download taxonomy-with-ids.<locale>.txt from Google (e.g. taxonomy-with-ids.de-DE.txt) and import it here. Category IDs are the same in every language, so existing mappings stay valid.')) ?></p>
        <div class="softaware-datafeed-import-row">
            <label for="softaware-datafeed-taxonomy-file"><?= $escaper->escapeHtml(__('Taxonomy File')) ?></label>
            <input type="file" id="softaware-datafeed-taxonomy-file" name="taxonomy_file" accept=".txt,text/plain"/>
            <button type="submit" class="action-secondary"><?= $escaper->escapeHtml(__('Import Taxonomy')) ?></button>
        </div>
        <p class="softaware-datafeed-muted"><?= $escaper->escapeHtml(__('Without a file, the included English list is loaded again.')) ?></p>
    </form>
</div>
