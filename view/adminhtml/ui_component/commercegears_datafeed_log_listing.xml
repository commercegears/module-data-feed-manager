<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">commercegears_datafeed_log_listing.commercegears_datafeed_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="feeds">
                <url path="commercegears_datafeed/feed/index"/>
                <class>back</class>
                <label translate="true">Back to Feeds</label>
            </button>
        </buttons>
        <spinner>commercegears_datafeed_log_columns</spinner>
        <deps>
            <dep>commercegears_datafeed_log_listing.commercegears_datafeed_log_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="commercegears_datafeed_log_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>CommerceGears_DataFeed::log</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="commercegears_datafeed_log_listing_data_source">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter_url_params" xsi:type="array">
                        <item name="feed_id" xsi:type="string">*</item>
                    </item>
                </item>
            </argument>
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="commercegears_datafeed_log_columns" component="CommerceGears_DataFeed/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="emptyTitle" xsi:type="string" translate="true">No feeds generated yet</item>
                <item name="emptyText" xsi:type="string" translate="true">Every generation (by cron, Generate Now or the command line) is listed here with its result, item count, file size and any errors.</item>
                <item name="emptyActionLabel" xsi:type="string" translate="true">Go to Feeds</item>
                <item name="emptyActionUrl" xsi:type="url" path="commercegears_datafeed/feed/index"/>
            </item>
        </argument>
        <column name="log_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="feed_id" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="CommerceGears\DataFeed\Model\Source\Feed"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Feed</label>
            </settings>
        </column>
        <column name="started_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="30">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Started</label>
            </settings>
        </column>
        <column name="trigger_source" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="CommerceGears\DataFeed\Model\Source\Trigger"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Started By</label>
            </settings>
        </column>
        <column name="status" class="CommerceGears\DataFeed\Ui\Component\Listing\Column\Status" sortOrder="50">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="duration" sortOrder="60">
            <settings>
                <label translate="true">Seconds</label>
            </settings>
        </column>
        <column name="items" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Items</label>
            </settings>
        </column>
        <column name="error_count" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Errors</label>
            </settings>
        </column>
        <column name="file_size" class="CommerceGears\DataFeed\Ui\Component\Listing\Column\FileSize" sortOrder="90">
            <settings>
                <label translate="true">File Size</label>
            </settings>
        </column>
        <column name="messages" class="CommerceGears\DataFeed\Ui\Component\Listing\Column\LogMessages" sortOrder="100">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Messages</label>
                <sortable>false</sortable>
            </settings>
        </column>
    </columns>
</listing>
