<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_datafeed_feed_form.softaware_datafeed_feed_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Feed</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Softaware\DataFeed\Block\Adminhtml\Feed\Edit\BackButton"/>
            <button name="delete" class="Softaware\DataFeed\Block\Adminhtml\Feed\Edit\DeleteButton"/>
            <button name="generate" class="Softaware\DataFeed\Block\Adminhtml\Feed\Edit\GenerateButton"/>
            <button name="save" class="Softaware\DataFeed\Block\Adminhtml\Feed\Edit\SaveButton"/>
        </buttons>
        <namespace>softaware_datafeed_feed_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>softaware_datafeed_feed_form.softaware_datafeed_feed_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_datafeed_feed_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="softaware_datafeed/feed/save"/>
        </settings>
        <dataProvider class="Softaware\DataFeed\Ui\DataProvider\FeedFormDataProvider" name="softaware_datafeed_feed_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>feed_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">General</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="feed_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>feed_id</dataScope>
            </settings>
        </field>
        <container name="file_info" component="Magento_Ui/js/form/components/html" sortOrder="5">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">softaware-datafeed-info</item>
                    <item name="content" xsi:type="string"/>
                </item>
            </argument>
        </container>
        <field name="is_active" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <notice translate="true">Disabled feeds are not generated by cron.</notice>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" formElement="input" sortOrder="20">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="store_id" formElement="select" sortOrder="30">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>int</dataType>
                <label translate="true">Store View</label>
                <notice translate="true">Product values, prices, URLs and stock are taken from this store view and its website.</notice>
                <dataScope>store_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="format" formElement="select" sortOrder="40">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Format</label>
                <dataScope>format</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>xml</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.template_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">true</param></params>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.columns_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">false</param></params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>json</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.template_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">true</param></params>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.columns_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">false</param></params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>csv</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.template_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">false</param></params>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.columns_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">true</param></params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="3">
                            <value>txt</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.template_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">false</param></params>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.columns_section</target>
                                    <callback>visible</callback>
                                    <params><param name="0" xsi:type="boolean">true</param></params>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\Format"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="filename" formElement="input" sortOrder="50">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">File Name</label>
                <notice translate="true">For example google_shopping.xml. Extension: .xml, .json, .csv, .txt or .tsv to match the format.</notice>
                <dataScope>filename</dataScope>
            </settings>
        </field>
        <field name="path" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Directory</label>
                <notice translate="true">Relative to the Magento root. Below pub/media/ the file gets a public URL; below var/ it stays private (use FTP upload).</notice>
                <dataScope>path</dataScope>
            </settings>
        </field>
        <field name="currency_code" formElement="select" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Currency</label>
                <notice translate="true">Prices are converted from the base currency with the rates in Stores &gt; Currency Rates.</notice>
                <dataScope>currency_code</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\Currency"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="template_section" sortOrder="20">
        <settings>
            <label translate="true">Template (XML / JSON)</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="template" formElement="textarea" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">28</item>
                    <item name="additionalClasses" xsi:type="string">softaware-datafeed-code</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template</label>
                <notice translate="true">{{ product.name | truncate(150) }} prints a value (escaped for XML/JSON automatically). {% for product in products %} … {% endfor %} repeats for every product; {% if … %} {% else %} {% endif %} and {% for image in product.images %} work inside it. See "Variables and filters" below.</notice>
                <dataScope>template</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="columns_section" sortOrder="30">
        <settings>
            <label translate="true">Columns and File Options (CSV / TXT)</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <visible>false</visible>
        </settings>
        <dynamicRows name="columns" sortOrder="10">
            <settings>
                <addButtonLabel translate="true">Add Column</addButtonLabel>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">true</param>
                </dndConfig>
                <additionalClasses>
                    <class name="softaware-datafeed-columns">true</class>
                </additionalClasses>
                <componentType>dynamicRows</componentType>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="header" formElement="input" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Header</label>
                        <dataScope>header</dataScope>
                    </settings>
                </field>
                <field name="value" formElement="input" sortOrder="20">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="additionalClasses" xsi:type="string">softaware-datafeed-code</item>
                            <item name="placeholder" xsi:type="string">{{ product.sku }}</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Value</label>
                        <dataScope>value</dataScope>
                    </settings>
                </field>
                <field name="default" formElement="input" sortOrder="30">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="additionalClasses" xsi:type="string">softaware-datafeed-code</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Default (when empty)</label>
                        <dataScope>default</dataScope>
                    </settings>
                </field>
                <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                        <componentType>actionDelete</componentType>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
        <field name="csv_delimiter" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Delimiter</label>
                <dataScope>csv_delimiter</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\Delimiter"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="csv_enclosure" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Enclosure</label>
                <dataScope>csv_enclosure</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\Enclosure"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="csv_encoding" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Encoding</label>
                <dataScope>csv_encoding</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\Encoding"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="csv_line_ending" formElement="select" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Line Ending</label>
                <dataScope>csv_line_ending</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\LineEnding"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="csv_include_header" formElement="checkbox" sortOrder="60">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Header Row</label>
                <dataScope>csv_include_header</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="preview_section" sortOrder="40">
        <settings>
            <label translate="true">Preview</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <container name="preview" component="Softaware_DataFeed/js/form/preview" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="url" xsi:type="url" path="softaware_datafeed/feed/preview"/>
                    <item name="provider" xsi:type="string">softaware_datafeed_feed_form.softaware_datafeed_feed_form_data_source</item>
                </item>
            </argument>
        </container>
    </fieldset>

    <fieldset name="reference_section" sortOrder="50">
        <settings>
            <label translate="true">Variables and Filters</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <container name="reference" component="Magento_Ui/js/form/components/html" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">softaware-datafeed-reference</item>
                    <item name="content" xsi:type="string"/>
                </item>
            </argument>
        </container>
    </fieldset>

    <fieldset name="filter_section" sortOrder="60">
        <settings>
            <label translate="true">Product Filters</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="filter_enabled_only" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled Products Only</label>
                <dataScope>filter_enabled_only</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="filter_in_stock_only" formElement="checkbox" sortOrder="20">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">In-Stock Products Only</label>
                <notice translate="true">Google, Meta and Pinterest accept out-of-stock items (availability "out of stock"), so this is usually off.</notice>
                <dataScope>filter_in_stock_only</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="filter_types" formElement="multiselect" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Product Types</label>
                <notice translate="true">None selected = all types.</notice>
                <dataScope>filter_types</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\ProductType"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="filter_attribute_sets" formElement="multiselect" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Attribute Sets</label>
                <notice translate="true">None selected = all attribute sets.</notice>
                <dataScope>filter_attribute_sets</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Catalog\Model\Product\AttributeSet\Options"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="filter_visibility" formElement="multiselect" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Visibility</label>
                <notice translate="true">None selected = all. Variants of configurable products are added through "Configurable Products" below, whatever their visibility.</notice>
                <dataScope>filter_visibility</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Catalog\Model\Product\Visibility"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="parent_child_mode" formElement="select" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Configurable Products</label>
                <notice translate="true">Variants get item_group_id = parent SKU and fall back to the parent URL and image.</notice>
                <dataScope>parent_child_mode</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\ParentChildMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="filter_categories" component="Magento_Ui/js/form/element/ui-select" formElement="select" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">2</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <dataType>text</dataType>
                <label translate="true">Categories</label>
                <notice translate="true">Subcategories are included. None selected = all categories.</notice>
                <dataScope>filter_categories</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Catalog\Ui\Component\Product\Form\Categories\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="filter_category_mode" formElement="select" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Category Filter</label>
                <dataScope>filter_category_mode</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\CategoryMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <dynamicRows name="conditions" sortOrder="90">
            <settings>
                <label translate="true">Attribute Conditions</label>
                <addButtonLabel translate="true">Add Condition</addButtonLabel>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
                <componentType>dynamicRows</componentType>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="attribute" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Attribute</label>
                        <dataScope>attribute</dataScope>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Softaware\DataFeed\Model\Source\Attribute"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="operator" formElement="select" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Operator</label>
                        <dataScope>operator</dataScope>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Softaware\DataFeed\Model\Source\Operator"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="value" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Value</label>
                        <dataScope>value</dataScope>
                    </settings>
                </field>
                <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                        <componentType>actionDelete</componentType>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
        <container name="conditions_note" component="Magento_Ui/js/form/components/html" sortOrder="95">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">softaware-datafeed-note</item>
                    <item name="content" xsi:type="string" translate="true">All conditions must match. For dropdown attributes enter the option label (e.g. Red) or its ID. Dates as YYYY-MM-DD.</item>
                </item>
            </argument>
        </container>
        <field name="exclude_skus" formElement="textarea" sortOrder="100">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">3</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Exclude SKUs</label>
                <notice translate="true">One per line or comma separated.</notice>
                <dataScope>exclude_skus</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="schedule_section" sortOrder="70">
        <settings>
            <label translate="true">Schedule</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="schedule_type" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Generate</label>
                <dataScope>schedule_type</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>manual</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_times</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_cron</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>times</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_times</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_cron</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>cron</value>
                            <actions>
                                <action name="0">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_times</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>softaware_datafeed_feed_form.softaware_datafeed_feed_form.schedule_section.schedule_cron</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\ScheduleType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="schedule_times" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Times</label>
                <notice translate="true">24-hour times in the store view's timezone, comma separated, e.g. 03:00, 15:00.</notice>
                <dataScope>schedule_times</dataScope>
            </settings>
        </field>
        <field name="schedule_cron" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Cron Expression</label>
                <notice translate="true">minute hour day-of-month month day-of-week in the store view's timezone, e.g. "0 */4 * * *" (every 4 hours) or "30 2 * * 1-5" (weekdays 02:30).</notice>
                <dataScope>schedule_cron</dataScope>
            </settings>
        </field>
        <container name="schedule_info" component="Magento_Ui/js/form/components/html" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">softaware-datafeed-note</item>
                    <item name="content" xsi:type="string"/>
                </item>
            </argument>
        </container>
    </fieldset>

    <fieldset name="delivery_section" sortOrder="80">
        <settings>
            <label translate="true">Delivery (FTP / SFTP)</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="ftp_enabled" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Upload After Generation</label>
                <notice translate="true">The local file is always written; this also uploads it.</notice>
                <dataScope>ftp_enabled</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="ftp_protocol" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Protocol</label>
                <dataScope>ftp_protocol</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\DataFeed\Model\Source\FtpProtocol"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="ftp_host" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Host</label>
                <dataScope>ftp_host</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_port" formElement="input" sortOrder="40">
            <settings>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Port</label>
                <notice translate="true">Empty = 22 for SFTP, 21 for FTP/FTPS.</notice>
                <dataScope>ftp_port</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_username" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Username</label>
                <dataScope>ftp_username</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_password" formElement="input" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="elementTmpl" xsi:type="string">Softaware_DataFeed/form/element/password</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Password</label>
                <notice translate="true">Stored encrypted. Leave unchanged to keep the saved password.</notice>
                <dataScope>ftp_password</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_path" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Remote Directory</label>
                <notice translate="true">Must exist on the server. Empty = login directory.</notice>
                <dataScope>ftp_path</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_host_key" formElement="input" sortOrder="75">
            <settings>
                <dataType>text</dataType>
                <label translate="true">SFTP Host Key</label>
                <notice translate="true">SHA256 fingerprint of the server's key. Saved automatically on the first upload; later uploads stop before the password is sent if the server's key changes. Clear it if the server was really replaced.</notice>
                <placeholder translate="true">Saved on the first upload</placeholder>
                <dataScope>ftp_host_key</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
        </field>
        <field name="ftp_passive" formElement="checkbox" sortOrder="80">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Passive Mode (FTP)</label>
                <dataScope>ftp_passive</dataScope>
                <imports>
                    <link name="visible">${ $.parentName }.ftp_enabled:checked</link>
                </imports>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <container name="ftp_test" component="Softaware_DataFeed/js/form/connection-test" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="url" xsi:type="url" path="softaware_datafeed/feed/testConnection"/>
                    <item name="provider" xsi:type="string">softaware_datafeed_feed_form.softaware_datafeed_feed_form_data_source</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">${ $.parentName }.ftp_enabled:checked</item>
                    </item>
                </item>
            </argument>
        </container>
    </fieldset>
</form>
